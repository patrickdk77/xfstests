#
# FS QA Test 387
#
# Create a heavily reflinked file, then check whether we can truncate
# it correctly.
#
. ./common/preamble
_begin_fstest auto clone

# Import common functions.
. ./common/filter
. ./common/reflink

# Modify as appropriate.
_require_scratch_reflink

#btrfs needs 256mb to create default blockgroup fs
_scratch_mkfs_sized $((256 * 1024 * 1024)) >> $seqres.full 2>&1
_scratch_mount

testfile=$SCRATCH_MNT/testfile
dummyfile=$SCRATCH_MNT/dummyfile
blocksize=$((128 * 1024))

# create a dummy file that occupies fs space freed (below) just
# before the truncate, leaving slack for the truncate's own
# metadata. CoW filesystems with heavy reflink metadata (e.g.
# ZFS) need more slack than btrfs's ~1MB; 4MB stays small while
# sitting above the ~2MB floor measured on ZFS (below ~2MB the
# freed space is absorbed by the pool reserve and never becomes
# available on a near-full pool).
_pwrite_byte 0xcdcdcdcd 0 $((4 * 1024 * 1024)) $dummyfile > /dev/null
_pwrite_byte 0xcdcdcdcd 0 $blocksize  $testfile > /dev/null

echo "Silence is golden"
for ((i = 0; i < 16384; i++)); do
	_reflink_range $testfile 0 $testfile $(($i * $blocksize)) \
		$blocksize > /dev/null 2>&1
done

# consume all remaining free space
dd if=/dev/zero of=$SCRATCH_MNT/space >/dev/null 2>&1
_scratch_sync

# fs is full now and fs internal operations may need some free space to truncate
# the heavily-reflinked file (btrfs reserves transaction space; ZFS needs space
# for the reflink/BRT metadata). Free the dummy file's space (sized above).
rm -f $dummyfile
# ZFS frees an unlinked file's blocks via a deferred-free list
# that a syncfs (_scratch_sync) does not drain, so without this
# the slack would not be reclaimed before the truncate and the
# test flakes on ENOSPC. Force a full pool sync on ZFS to
# reclaim it deterministically.
[ "$FSTYP" = "zfs" ] && $ZPOOL_PROG sync "$SCRATCH_ZPOOL_NAME"
$XFS_IO_PROG -f -c "truncate 0" $testfile

status=0
exit
