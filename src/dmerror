# hackity hack hack - first arg is the test number, second arg is op.
# This is needed so that dmerror names the dm dev correctly.
seq=$1

. ./common/config
. ./common/dmerror
# This helper runs as its own process (exec'd by e.g. src/fsync-err), so it
# does not go through common/rc's _source_specific_fs.  Pull in the fs-specific
# helpers directly: _dmerror_load_working_table calls _zfs_dmerror_clear (in
# common/zfs) to resume the ZFS pool after restoring the working table.
[ -f "./common/$FSTYP" ] && . "./common/$FSTYP"

if [ -z "$DMERROR_DEV" ]; then
	echo "Caller should have run _dmerror_init."
	exit 1
fi

case $2 in
load_error_table)
	_dmerror_load_error_table
	;;
load_working_table)
	_dmerror_load_working_table
	;;
*)
	echo "Usage: $0 {load_error_table|load_working_table}"
	exit 1
	;;
esac

status=0
exit
