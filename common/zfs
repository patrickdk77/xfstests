#
# Common ZFS-specific helpers, sourced from common/config when FSTYP=zfs.

# Discover zfs/zpool via PATH if available (works on distros that don't put
# them in /sbin, e.g. NixOS). Fall back to the canonical /sbin location.
ZPOOL_PROG=$(command -v zpool 2>/dev/null || echo /sbin/zpool)
ZFS_PROG=$(command -v zfs 2>/dev/null || echo /sbin/zfs)

_zfs_require_scratch_zpool_name()
{
	if [ -z "$SCRATCH_ZPOOL_NAME" ]; then
		_fail "SCRATCH_ZPOOL_NAME unset"
	fi
}

# Destroy the scratch zpool if it exists, so _scratch_mkfs paths can recreate it.
# Also detaches any loop devices stacked on $SCRATCH_DEV — _zfs_scratch_mkfs_sized
# uses one to fake a smaller pool, and a crashed prior run could leave one behind.
_zfs_destroy_scratch_pool()
{
	_zfs_require_scratch_zpool_name
	if $ZPOOL_PROG list -H $SCRATCH_ZPOOL_NAME > /dev/null 2>&1; then
		$ZPOOL_PROG destroy -f $SCRATCH_ZPOOL_NAME
	fi
	if [ -n "$SCRATCH_DEV" ] && [ -b "$SCRATCH_DEV" ]; then
		losetup -j $SCRATCH_DEV | awk -F: '{print $1}' | \
			xargs -r -n1 losetup -d
	fi
}

# Drop the ARC for a pool by exporting and re-importing it.
#
# Tests cycle a mount to force the next read to come from the device.
# That works where the cache dies with the mount, but on ZFS the cache
# is the ARC, which belongs to the pool, not the dataset: unmounting a
# dataset leaves the pool imported and every block still cached, so the
# read never reaches the device and the test silently verifies against
# memory.  Exporting the pool is what actually drops it.  A suspended
# pool cannot be exported, so leave it alone.
_zfs_cycle_pool()
{
	local pool=$1
	[ -n "$pool" ] || return 0

	local health
	health=$($ZPOOL_PROG list -H -o health $pool 2>/dev/null)
	[ -n "$health" ] || return 0
	[ "$health" = "SUSPENDED" ] && return 0

	$ZPOOL_PROG export $pool >/dev/null 2>&1 || return 0
	# Search /dev/mapper too: the pool may sit on a dm device
	# (dm-error) or on a loop device stacked on $SCRATCH_DEV.
	$ZPOOL_PROG import -d /dev -d /dev/mapper $pool >/dev/null 2>&1 || \
		$ZPOOL_PROG import $pool >/dev/null 2>&1 || \
		_fail "failed to re-import $pool after ARC drop"
}

_zfs_cycle_scratch_pool()
{
	_zfs_require_scratch_zpool_name
	_zfs_cycle_pool $SCRATCH_ZPOOL_NAME
}

# $TEST_DEV is pool/dataset; the ARC belongs to the pool.
_zfs_cycle_test_pool()
{
	_zfs_cycle_pool "${TEST_DEV%%/*}"
}

ZFS_SCRATCH_MKFS_OPTS="-O mountpoint=legacy -O relatime=off -O compression=off"

# recordsize=64K (vs the 128K ZFS default) so tests that gate on
# _require_congruent_file_oplen with 64K op lengths can actually run; the
# default notruns ~36 of them with "alloc unit 131072 larger than op length
# 65536". 4K would unblock more in theory but exposes ZFS reflink+zero-range
# integrity races under fsx — see generic/075 / 091 / 363. 64K is the safe
# minimum that resolves the known 36 cases without that fallout.
# Set after pool creation so callers (e.g. _scratch_mkfs_blocksized) can
# override via `zfs set` without conflicting with `zpool create -O`.
_zfs_set_default_recordsize()
{
	$ZFS_PROG set recordsize=64K $SCRATCH_ZPOOL_NAME
}

# Create a fresh scratch zpool/dataset on $SCRATCH_DEV.
_zfs_scratch_mkfs()
{
	_zfs_destroy_scratch_pool
	$ZPOOL_PROG create -f $ZFS_SCRATCH_MKFS_OPTS $* $MKFS_OPTIONS \
		$SCRATCH_ZPOOL_NAME $SCRATCH_DEV && \
		_zfs_set_default_recordsize
}

# Create a scratch zpool spanning $SCRATCH_DEV_POOL.
_zfs_scratch_pool_mkfs()
{
	_zfs_require_scratch_zpool_name
	$ZPOOL_PROG create -f $ZFS_SCRATCH_MKFS_OPTS $* $MKFS_OPTIONS \
		$SCRATCH_ZPOOL_NAME $SCRATCH_DEV_POOL && \
		_zfs_set_default_recordsize
}

# Create a scratch zpool of approximately the given size by stacking a sized
# loop device on top of $SCRATCH_DEV, so the pool actually runs out of space
# (ENOSPC) instead of hitting a refquota cap (EDQUOT).
_zfs_scratch_mkfs_sized()
{
	local fssize=$1
	shift
	_zfs_destroy_scratch_pool
	local loop
	loop=$(losetup --find --show --sizelimit=$fssize $SCRATCH_DEV) || \
		_fail "losetup --sizelimit=$fssize $SCRATCH_DEV failed"
	$ZPOOL_PROG create -f $ZFS_SCRATCH_MKFS_OPTS \
		$MKFS_OPTIONS $* $SCRATCH_ZPOOL_NAME $loop && \
		_zfs_set_default_recordsize
}

# Create a dataset on $TEST_DEV (which must already be a pool/parent-dataset).
_zfs_test_mkfs()
{
	$ZFS_PROG create -o mountpoint=legacy $* $TEST_DEV
}

# _try_mkfs_dev builds a filesystem on a device the test supplies itself:
# a loop device or image inside $SCRATCH_MNT, an LVM volume, a scsi_debug
# disk.  The test then mounts that device directly.  Neither half maps to
# ZFS.  Making a filesystem there means a second pool, but a pool is
# mounted by dataset name, not by its backing device, so the test's mount
# has nothing to name; and the pool cannot reuse $SCRATCH_ZPOOL_NAME,
# which is already imported ("cannot create 'scratch': pool already
# exists" -- how generic/648 failed).  Skip instead of failing, so these
# tests report why rather than needing to be listed in exclude.zfs.txt.
_zfs_try_mkfs_dev()
{
	_notrun "ZFS mounts a pool by dataset name, not by backing device; cannot mkfs a caller-supplied device"
}

# Emit the mount-source argument used by _scratch_mount_options. For ZFS the
# kernel mounts off the zpool dataset name, not the block device.
_zfs_scratch_mount_source()
{
	echo "$SCRATCH_ZPOOL_NAME"
}

# dm-error support.  The generic dm-error harness wraps $SCRATCH_DEV in a
# dm-linear device and hot-swaps it to the 'error' target to inject a
# whole-device I/O failure.  ZFS owns its vdev directly, so we rebuild the
# (empty, freshly mkfs'd) scratch pool on top of the dm device instead.
#
# Created failmode=continue so a whole-device error is returned to
# userspace as EIO instead of blocking forever: failmode=wait (the
# default) leaves the pool, the app, and even dmsetup wedged in D state,
# needing a reboot.  The pool suspends on the error and stays suspended
# until 'zpool clear', which _dmerror_load_working_table issues after
# restoring the linear table.
_zfs_dmerror_init()
{
	_dmerror_setup "$@"

	_zfs_destroy_scratch_pool
	_dmsetup_remove $DMERROR_NAME
	_dmsetup_create $DMERROR_NAME --table "$DMLINEAR_TABLE" || \
		_fatal "failed to create dm linear device"

	$ZPOOL_PROG create -f -o failmode=continue \
		$ZFS_SCRATCH_MKFS_OPTS $MKFS_OPTIONS \
		$SCRATCH_ZPOOL_NAME $DMERROR_DEV || \
		_fatal "failed to create zpool on dm-error device"
	_zfs_set_default_recordsize

	# The dm-error injection deliberately fails all pool I/O; ZFS
	# logs the resulting pool suspension (and the resume on recovery)
	# as WARNINGs.  Whitelist them so _check_dmesg does not flag the
	# expected noise.
	_add_dmesg_filter \
		"Pool '$SCRATCH_ZPOOL_NAME' has encountered an uncorrectable"
	_add_dmesg_filter \
		"Pool '$SCRATCH_ZPOOL_NAME' was suspended and is being resumed"
}

# Resume a scratch pool left suspended by a whole-device error, after the
# dm device has been switched back to a working table.
_zfs_dmerror_clear()
{
	$ZPOOL_PROG clear $SCRATCH_ZPOOL_NAME
}

# Tear down a dm-error scratch pool: switch the dm device back to a working
# table, clear and destroy the pool (it holds the dm device), remove dm.
_zfs_dmerror_cleanup()
{
	$DMSETUP_PROG suspend --noflush --nolockfs $DMERROR_NAME \
		>/dev/null 2>&1
	$DMSETUP_PROG load $DMERROR_NAME --table "$DMLINEAR_TABLE" \
		>/dev/null 2>&1
	$DMSETUP_PROG resume $DMERROR_NAME >/dev/null 2>&1
	$ZPOOL_PROG clear $SCRATCH_ZPOOL_NAME >/dev/null 2>&1
	_unmount $SCRATCH_MNT >/dev/null 2>&1
	_zfs_destroy_scratch_pool >/dev/null 2>&1
	_dmsetup_remove $DMERROR_NAME
	unset DMERROR_DEV DMLINEAR_TABLE DMERROR_TABLE
}

_require_zfs_scratch_dev()
{
	if [ -z "$SCRATCH_ZPOOL_NAME" ]; then
		_notrun "SCRATCH_ZPOOL_NAME unset"
	fi
	if [ -z "$SCRATCH_DEV" -o "`_is_block_dev "$SCRATCH_DEV"`" = "" ]; then
		_notrun "this test requires a valid \$SCRATCH_DEV"
	fi
}

_require_zfs_test_dev()
{
	# TEST_DEV must be of the form 'pool/dataset'
	if ! $ZFS_PROG list -H $TEST_DEV > /dev/null 2>&1; then
		_notrun "this test requires a valid \$TEST_DEV"
	fi
	if [ ! -d "$TEST_DIR" ]; then
		_notrun "this test requires a valid \$TEST_DIR"
	fi
}

# Tests that want an uncompressed filesystem can _require_no_compress.
# Scratch pools created via _zfs_scratch_mkfs already have compression=off; we
# verify the user's TEST_DEV is uncompressed too, otherwise on-disk block
# accounting (statfs, du, etc.) won't match logical bytes written.
_require_zfs_no_compress()
{
	local c
	c=$($ZFS_PROG get -H -o value compression $TEST_DEV 2>/dev/null)
	if [ "$c" != "off" ]; then
		_notrun "TEST_DEV compression is '$c'; need 'off' for this test"
	fi
}
